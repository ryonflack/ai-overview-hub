SERPAPI_API_KEY=
PERPLEXITY_API_KEY=
PERPLEXITY_PRESET=fast
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# User-simulated responses (operator-only; vendors are never shown to customers).
# SIMULATED_VENDOR sets the default for every engine that supports it: oxylabs | dataforseo.
# Per-engine pins override it. DataForSEO can simulate ChatGPT only; Perplexity always uses Oxylabs.
SIMULATED_VENDOR=oxylabs
SIMULATED_VENDOR_CHATGPT=
SIMULATED_VENDOR_PERPLEXITY=
OXYLABS_USERNAME=
OXYLABS_PASSWORD=
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# Stripe: same names in every Vercel environment. STRIPE_API_SECRET is the secret key (STRIPE_SECRET_KEY also works). Preview/staging = sandbox (sk_test_), Production = live (sk_live_). STRIPE_WEBHOOK_SECRET is the signing secret of the endpoint for
# /api/stripe/webhook (Dashboard > Developers > Webhooks). STRIPE_PRICE_ID is the Starter price (lookup key starter_monthly); see docs/BILLING.md.
STRIPE_API_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
ERROR_REPORTING_ENABLED=false
# Email through Resend (sender domain verified in Resend). Without a key, emails are logged instead of sent.
RESEND_API_KEY=
EMAIL_FROM=AI Overview Hub <notifications@aioverviewhub.com>
EMAIL_PROVIDER=console
APP_URL=http://localhost:4173
API_URL=http://localhost:8787
# Neon Postgres (set by the Vercel Neon integration). Leave empty locally: `npm run dev:api` uses an in-process PostgreSQL in .data/.
DATABASE_URL=
USE_MOCK_SERP_PROVIDERS=true
TURNSTILE_SECRET_KEY=
# Customer sign-in: Neon Auth base URL (the Vercel Neon integration sets it as DATABASE_NEON_AUTH_BASE_URL).
NEON_AUTH_BASE_URL=
# Protects /api/internal/worker (Vercel Cron sends it automatically).
CRON_SECRET=
# Most paid provider calls per calendar month across all workspaces (default 2000). Runs on mock providers don't count.
PLATFORM_MONTHLY_CHECK_CAP=
# Local development against a deployed environment: npm run dev with these proxies /api and /auth there.
API_PROXY_TARGET=
VERCEL_BYPASS=
# Admin control panel (admin.aioverviewhub.com). ADMIN_TOTP_KEY encrypts operator authenticator secrets: `npm run admin:key`.
ADMIN_URL=http://localhost:4174
ADMIN_ORIGIN=http://localhost:4174
ADMIN_TOTP_KEY=
# Read-only Vercel token for deployment health in the panel; VERCEL_PROJECT_IDS is comma-separated.
VERCEL_API_TOKEN=
VERCEL_TEAM_ID=
VERCEL_TEAM_SLUG=
VERCEL_PROJECT_IDS=
