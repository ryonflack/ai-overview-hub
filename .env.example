SERPAPI_API_KEY=
PERPLEXITY_API_KEY=
PERPLEXITY_PRESET=fast
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# User-simulated responses (operator-only; vendors are never shown to customers).
# SIMULATED_VENDOR sets the default for every engine that supports it: oxylabs | dataforseo.
# Per-engine pins override it. DataForSEO can simulate ChatGPT only; Perplexity always uses Oxylabs.
SIMULATED_VENDOR=oxylabs
SIMULATED_VENDOR_CHATGPT=
SIMULATED_VENDOR_PERPLEXITY=
OXYLABS_USERNAME=
OXYLABS_PASSWORD=
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
ERROR_REPORTING_ENABLED=false
EMAIL_PROVIDER=console
EMAIL_API_KEY=
APP_URL=http://localhost:4173
API_URL=http://localhost:8787
DATABASE_URL=file:local.db
USE_MOCK_SERP_PROVIDERS=true
TURNSTILE_SECRET_KEY=
SESSION_SECRET=
# Admin control panel (admin.aioverviewhub.com). ADMIN_TOTP_KEY encrypts operator authenticator secrets: `npm run admin:key`.
ADMIN_URL=http://localhost:4174
ADMIN_ORIGIN=http://localhost:4174
ADMIN_TOTP_KEY=
# Read-only Vercel token for deployment health in the panel; VERCEL_PROJECT_IDS is comma-separated.
VERCEL_API_TOKEN=
VERCEL_TEAM_ID=
VERCEL_TEAM_SLUG=
VERCEL_PROJECT_IDS=
