{
  "name": "ai-overview-hub",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:api": "node scripts/dev-api.mjs",
    "dev:admin": "vite --config apps/admin/vite.config.ts --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "build:admin": "tsc -b && vite build --config apps/admin/vite.config.ts",
    "vercel-build": "node scripts/migrate.mjs && npm run build && node scripts/build-vercel.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run --root . --coverage.enabled=false",
    "test:watch": "vitest",
    "security:audit": "npm audit --audit-level=high",
    "admin:key": "node scripts/create-operator.mjs --generate-key",
    "admin:operator": "node scripts/create-operator.mjs",
    "demo:accounts": "node scripts/seed-demo-accounts.mjs"
  },
  "dependencies": {
    "@neondatabase/neon-js": "latest",
    "@neondatabase/serverless": "latest",
    "@vercel/functions": "latest",
    "@vitejs/plugin-react": "latest",
    "hono": "latest",
    "jose": "latest",
    "jszip": "latest",
    "papaparse": "latest",
    "react": "latest",
    "react-dom": "latest",
    "stripe": "latest",
    "xlsx": "latest"
  },
  "devDependencies": {
    "@electric-sql/pglite": "latest",
    "@eslint/js": "latest",
    "@hono/node-server": "latest",
    "@types/node": "latest",
    "@types/papaparse": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "latest",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "globals": "latest",
    "rolldown": "latest",
    "typescript": "latest",
    "typescript-eslint": "latest",
    "vite": "latest",
    "vitest": "latest"
  }
}
